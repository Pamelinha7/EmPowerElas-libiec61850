  </DataTypeTemplates>

  <Communication>
    <SubNetwork name="Subnet1" type="8-MMS">
      <Text>Rede da maquete EmPowerElas (roteador EmpowerElas)</Text>
      <ConnectedAP iedName="EmpElas_PROT" apName="AP1">
        <Address>
          <P type="IP">192.168.10.101</P>
          <P type="IP-SUBNET">255.255.255.0</P>
          <P type="IP-GATEWAY">192.168.10.1</P>
          <P type="OSI-AP-Title">1,3,9,999,1</P>
          <P type="OSI-AE-Qualifier">12</P>
          <P type="OSI-PSEL">00000001</P>
          <P type="OSI-SSEL">0001</P>
          <P type="OSI-TSEL">0001</P>
        </Address>
        <!-- Enderecamento do GOOSE de trip. O assinante (EmpElas_CTRL)
             precisa usar exatamente este APPID e este MAC. -->
        <GSE ldInst="MEDPROT" cbName="gcbTrip">
          <Address>
            <P type="MAC-Address">01-0C-CD-01-00-01</P>
            <P type="APPID">1001</P>
            <P type="VLAN-ID">000</P>
            <P type="VLAN-PRIORITY">4</P>
          </Address>
          <MinTime>10</MinTime>
          <MaxTime>1000</MaxTime>
        </GSE>
        <!-- Enderecamento do GOOSE de comandos das chaves. O assinante
             (EmpElas_CTRL) precisa usar exatamente este APPID e este MAC. -->
        <GSE ldInst="MEDPROT" cbName="gcbCmd">
          <Address>
            <P type="MAC-Address">01-0C-CD-01-00-03</P>
            <P type="APPID">1003</P>
            <P type="VLAN-ID">000</P>
            <P type="VLAN-PRIORITY">4</P>
          </Address>
          <MinTime>10</MinTime>
          <MaxTime>1000</MaxTime>
        </GSE>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
</SCL>
