<?xml version="1.0" encoding="UTF-8"?>
<!--
  EmPowerElas - Maquete de Subestacao Digital
  IED de medicao e protecao (Raspberry Pi 1): EmpElas_PROT

  Recebe as amostras de corrente e tensao da merging unit (EmpElas_MU)
  por Sampled Values, calcula os valores eficazes das tres fases, roda a
  protecao de sobrecorrente e, quando ela atua, publica o trip por GOOSE
  para o IED de controle de vao (EmpElas_CTRL).

  Nao ha mais botao de falta aqui: a falta acontece na "linha", que e a
  merging unit. Este IED so mede e decide, como um rele real.

  Tambem e o IED de controle das chaves seccionadoras:
    - CSWI1-3 recebem o comando do operador (supervisorio, MMS);
    - CILO1-3 fazem o intertravamento: a chave N so abre ou fecha com o
      disjuntor N aberto;
    - o comando liberado sai por GOOSE (gcbCmd) para a Pi do servo
      (EmpElas_CTRL), que publica de volta a posicao de tudo (gcbPos).
-->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL">
  <Header id="EmpElas" nameStructure="IEDName" />
  <IED name="EmpElas_PROT">
    <Services>
      <GetDirectory /><GetDataObjectDefinition /><ReadWrite /><GetCBValues />
      <ConfLNs fixPrefix="true" fixLnInst="true" />
      <GOOSE max="2" />
    </Services>
    <AccessPoint name="AP1">
      <Server>
        <Authentication />

        <!-- Medicao e protecao -->
        <LDevice inst="MEDPROT">
          <LN0 lnClass="LLN0" lnType="LLN01" inst="">
            <!-- Conjunto de dados publicado no GOOSE: o sinal de trip -->
            <DataSet name="dsTrip">
              <FCDA ldInst="MEDPROT" prefix="" lnClass="PTRC" lnInst="1" doName="Tr" daName="general" fc="ST" />
            </DataSet>
            <!-- Conjunto de dados publicado no GOOSE de comandos das chaves.
                 A Pi do servo le nesta ordem: abrir 1, fechar 1, abrir 2, fechar 2, abrir 3, fechar 3. -->
            <DataSet name="dsCmd">
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="1" doName="OpOpn" daName="general" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="1" doName="OpCls" daName="general" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="2" doName="OpOpn" daName="general" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="2" doName="OpCls" daName="general" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="3" doName="OpOpn" daName="general" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="3" doName="OpCls" daName="general" fc="ST" />
            </DataSet>
            <!-- Conjunto de dados dos eventos (cada dado inteiro: valor, qualidade e horario) -->
            <DataSet name="dsEventos">
              <FCDA ldInst="MEDPROT" prefix="" lnClass="PTOC" lnInst="1" doName="Str" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="PTOC" lnInst="1" doName="Op" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="PTRC" lnInst="1" doName="Tr" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="1" doName="Pos" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="2" doName="Pos" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CSWI" lnInst="3" doName="Pos" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CILO" lnInst="1" doName="EnaOpn" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CILO" lnInst="2" doName="EnaOpn" fc="ST" />
              <FCDA ldInst="MEDPROT" prefix="" lnClass="CILO" lnInst="3" doName="EnaOpn" fc="ST" />
            </DataSet>
            <!-- Relatorio de eventos: avisa o supervisorio a cada mudanca de protecao, chaves e intertravamento,
                 com o horario de cada valor. Bufferizado: o que acontecer enquanto o
                 supervisorio estiver desconectado e entregue quando ele voltar.
                 max="2": dois clientes ao mesmo tempo (brcbEventos01 e brcbEventos02),
                 por exemplo o Elipse e o programa testes/ver_eventos. -->
            <ReportControl name="brcbEventos" rptID="EmpElas_PROT_Eventos" datSet="dsEventos" confRev="1" buffered="true" bufTime="50" intgPd="0">
              <TrgOps dchg="true" qchg="true" dupd="false" period="false" gi="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" dataRef="true" entryID="true" configRef="true" bufOvfl="true" />
              <RptEnabled max="2" />
            </ReportControl>
            <DOI name="Mod" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="NamPlt" /> <DOI name="Diag" /> <DOI name="LEDRs" />
            <!-- Bloco de controle GOOSE: publica o dsTrip para o IED de vao -->
            <GSEControl name="gcbTrip" datSet="dsTrip" appID="EmpElasTrip" confRev="1" type="GOOSE" />
            <!-- Bloco de controle GOOSE: publica o dsCmd (comandos das chaves) para a Pi do servo -->
            <GSEControl name="gcbCmd" datSet="dsCmd" appID="EmpElasCmd" confRev="1" type="GOOSE" />
          </LN0>
          <LN lnClass="LPHD" lnType="LPHD1_Typ" inst="1" prefix="">
            <DOI name="NamPlt" /> <DOI name="PhyNam" /> <DOI name="PhyHealth" /> <DOI name="OutOv" /> <DOI name="Proxy" /> <DOI name="OpTmh" /> <DOI name="Sim" />
          </LN>

          <!-- Gestao de tempo: base para a lista de eventos com selo de tempo -->
          <LN lnClass="LTIM" lnType="LTIM1_Typ" inst="1" prefix="">
            <DOI name="Beh" /> <DOI name="Health" /> <DOI name="TmDT" />
          </LN>
          <LN lnClass="LTMS" lnType="LTMS1_Typ" inst="1" prefix="">
            <DOI name="TmSrc" /> <DOI name="TmSrcTyp" /> <DOI name="Beh" />
          </LN>

          <!-- Medicao das tres fases, calculada a partir do SV da merging unit.
               A: correntes (A). PhV: tensoes de fase (kV). PPV: tensoes entre fases (kV). -->
          <LN lnClass="MMXU" lnType="MMXU1_Typ" inst="1" prefix="">
            <DOI name="NamPlt" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="A" /> <DOI name="PhV" /> <DOI name="PPV" />
            <!-- De onde vem a medicao: o SV da merging unit (documentacao para as
                 ferramentas de engenharia; o programa assina o SV diretamente) -->
            <Inputs>
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TCTR" lnInst="1" doName="Amp" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TCTR" lnInst="2" doName="Amp" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TCTR" lnInst="3" doName="Amp" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TCTR" lnInst="4" doName="Amp" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TVTR" lnInst="1" doName="Vol" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TVTR" lnInst="2" doName="Vol" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TVTR" lnInst="3" doName="Vol" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
              <ExtRef iedName="EmpElas_MU" ldInst="MU01" prefix="" lnClass="TVTR" lnInst="4" doName="Vol" daName="instMag.i" serviceType="SMV" srcLDInst="MU01" srcLNClass="LLN0" srcCBName="MSVCB01" />
            </Inputs>
          </LN>

          <!-- Protecao de sobrecorrente de fase. Str e Op indicam tambem a fase. -->
          <LN lnClass="PTOC" lnType="PTOC1_Typ" inst="1" prefix="">
            <DOI name="Beh" /> <DOI name="Health" /> <DOI name="Str" /> <DOI name="Op" />
          </LN>

          <!-- Condicionamento do trip: e este sinal que vai no GOOSE.
               Tr.general = trip tripolar (o disjuntor abre as tres fases juntas). -->
          <LN lnClass="PTRC" lnType="PTRC1_Typ" inst="1" prefix="">
            <DOI name="Beh" /> <DOI name="Health" /> <DOI name="Tr" />
          </LN>
          <!-- Chaves seccionadoras: comando (CSWI) e intertravamento (CILO).
               Cada chave N pertence ao vao do disjuntor N. -->
          <LN lnClass="CSWI" lnType="CSWI1_Typ" inst="1" prefix="">
            <DOI name="Beh"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="Health"><DAI name="stVal"><Val>ok</Val></DAI></DOI>
            <DOI name="NamPlt"><DAI name="d"><Val>Comando da chave 1: libera pelo CILO1 e envia por GOOSE (gcbCmd)</Val></DAI></DOI>
            <DOI name="Pos"><DAI name="ctlModel"><Val>direct-with-normal-security</Val></DAI></DOI>
            <DOI name="OpOpn" /> <DOI name="OpCls" />
            <!-- Posicao real da chave: vem da Pi do servo, por GOOSE -->
            <Inputs>
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XSWI" lnInst="1" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
            </Inputs>
          </LN>
          <LN lnClass="CILO" lnType="CILO1_Typ" inst="1" prefix="">
            <DOI name="Beh"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="Health"><DAI name="stVal"><Val>ok</Val></DAI></DOI>
            <DOI name="NamPlt"><DAI name="d"><Val>Intertravamento da chave 1: so manobra com o disjuntor 1 aberto</Val></DAI></DOI>
            <DOI name="EnaOpn" /> <DOI name="EnaCls" />
            <!-- O que o intertravamento olha: disjuntor e chave do mesmo vao -->
            <Inputs>
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XCBR" lnInst="1" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XSWI" lnInst="1" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
            </Inputs>
          </LN>
          <LN lnClass="CSWI" lnType="CSWI1_Typ" inst="2" prefix="">
            <DOI name="Beh"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="Health"><DAI name="stVal"><Val>ok</Val></DAI></DOI>
            <DOI name="NamPlt"><DAI name="d"><Val>Comando da chave 2: libera pelo CILO2 e envia por GOOSE (gcbCmd)</Val></DAI></DOI>
            <DOI name="Pos"><DAI name="ctlModel"><Val>direct-with-normal-security</Val></DAI></DOI>
            <DOI name="OpOpn" /> <DOI name="OpCls" />
            <!-- Posicao real da chave: vem da Pi do servo, por GOOSE -->
            <Inputs>
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XSWI" lnInst="2" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
            </Inputs>
          </LN>
          <LN lnClass="CILO" lnType="CILO1_Typ" inst="2" prefix="">
            <DOI name="Beh"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="Health"><DAI name="stVal"><Val>ok</Val></DAI></DOI>
            <DOI name="NamPlt"><DAI name="d"><Val>Intertravamento da chave 2: so manobra com o disjuntor 2 aberto</Val></DAI></DOI>
            <DOI name="EnaOpn" /> <DOI name="EnaCls" />
            <!-- O que o intertravamento olha: disjuntor e chave do mesmo vao -->
            <Inputs>
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XCBR" lnInst="2" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XSWI" lnInst="2" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
            </Inputs>
          </LN>
          <LN lnClass="CSWI" lnType="CSWI1_Typ" inst="3" prefix="">
            <DOI name="Beh"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="Health"><DAI name="stVal"><Val>ok</Val></DAI></DOI>
            <DOI name="NamPlt"><DAI name="d"><Val>Comando da chave 3: libera pelo CILO3 e envia por GOOSE (gcbCmd)</Val></DAI></DOI>
            <DOI name="Pos"><DAI name="ctlModel"><Val>direct-with-normal-security</Val></DAI></DOI>
            <DOI name="OpOpn" /> <DOI name="OpCls" />
            <!-- Posicao real da chave: vem da Pi do servo, por GOOSE -->
            <Inputs>
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XSWI" lnInst="3" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
            </Inputs>
          </LN>
          <LN lnClass="CILO" lnType="CILO1_Typ" inst="3" prefix="">
            <DOI name="Beh"><DAI name="stVal"><Val>on</Val></DAI></DOI>
            <DOI name="Health"><DAI name="stVal"><Val>ok</Val></DAI></DOI>
            <DOI name="NamPlt"><DAI name="d"><Val>Intertravamento da chave 3: so manobra com o disjuntor 3 aberto</Val></DAI></DOI>
            <DOI name="EnaOpn" /> <DOI name="EnaCls" />
            <!-- O que o intertravamento olha: disjuntor e chave do mesmo vao -->
            <Inputs>
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XCBR" lnInst="3" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
              <ExtRef iedName="EmpElas_CTRL" ldInst="VAO" prefix="" lnClass="XSWI" lnInst="3" doName="Pos" daName="stVal" serviceType="GOOSE" srcLDInst="VAO" srcLNClass="LLN0" srcCBName="gcbPos" />
            </Inputs>
          </LN>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>

  <DataTypeTemplates>
    <LNodeType id="LLN01" lnClass="LLN0"><DO name="Mod" type="ENC_Mod"/><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="NamPlt" type="LPL_NamPlt"/><DO name="Diag" type="SPS_Generic"/><DO name="LEDRs" type="SPS_Generic"/></LNodeType>
    <LNodeType id="LPHD1_Typ" lnClass="LPHD"><DO name="NamPlt" type="LPL_NamPlt"/><DO name="PhyNam" type="DPL_Generic"/><DO name="PhyHealth" type="ENS_Health"/><DO name="OutOv" type="SPS_Generic"/><DO name="Proxy" type="SPS_Generic"/><DO name="OpTmh" type="INS_Generic"/><DO name="Sim" type="SPS_Generic"/></LNodeType>
    <LNodeType id="LTIM1_Typ" lnClass="LTIM"><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="TmDT" type="SPS_Generic"/></LNodeType>
    <LNodeType id="LTMS1_Typ" lnClass="LTMS"><DO name="TmSrc" type="ENS_Generic"/><DO name="TmSrcTyp" type="ENS_Generic"/><DO name="Beh" type="ENS_Beh"/></LNodeType>
    <LNodeType id="MMXU1_Typ" lnClass="MMXU"><DO name="NamPlt" type="LPL_NamPlt"/><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="A" type="WYE_1"/><DO name="PhV" type="WYE_1"/><DO name="PPV" type="DEL_1"/></LNodeType>
    <LNodeType id="PTOC1_Typ" lnClass="PTOC"><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="Str" type="ACD_Fases"/><DO name="Op" type="ACT_Fases"/></LNodeType>
    <LNodeType id="PTRC1_Typ" lnClass="PTRC"><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="Tr" type="ACT_Generic"/></LNodeType>
    <LNodeType id="CSWI1_Typ" lnClass="CSWI"><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="NamPlt" type="LPL_NamPlt"/><DO name="Pos" type="DPC_Generic"/><DO name="OpOpn" type="ACT_Generic"/><DO name="OpCls" type="ACT_Generic"/></LNodeType>
    <LNodeType id="CILO1_Typ" lnClass="CILO"><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="NamPlt" type="LPL_NamPlt"/><DO name="EnaOpn" type="SPS_Simples"/><DO name="EnaCls" type="SPS_Simples"/></LNodeType>

    <DOType id="ENC_Mod" cdc="ENC"><DA name="stVal" bType="Enum" type="Beh" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /><DA name="ctlModel" type="CtlModels" bType="Enum" fc="CF" /></DOType>
    <DOType id="ENS_Beh" cdc="ENS"><DA name="stVal" bType="Enum" type="Beh" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>
    <DOType id="ENS_Health" cdc="ENS"><DA name="stVal" bType="Enum" type="HealthKind" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>
    <DOType id="ENS_Generic" cdc="ENS"><DA name="stVal" bType="INT8U" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>
    <DOType id="SPS_Generic" cdc="SPS"><DA name="stVal" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /><DA name="ctlModel" type="CtlModels" bType="Enum" fc="CF" /></DOType>
    <DOType id="SPS_Simples" cdc="SPS"><DA name="stVal" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>
    <!-- Posicao com comando: mesmo formato das chaves e disjuntores da Pi do servo,
         para os botoes do Elipse funcionarem igual (1 = abrir, 2 = fechar) -->
    <DOType id="DPC_Generic" cdc="DPC"><DA name="stVal" bType="Dbpos" type="Dbpos" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /><DA name="ctlModel" type="CtlModels" bType="Enum" fc="CF" /><DA name="Oper" type="DPCOperate_1" bType="Struct" fc="CO" /></DOType>
    <DOType id="INS_Generic" cdc="INS"><DA name="stVal" bType="INT32" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>

    <!-- Medicao trifasica (formato da norma) -->
    <DOType id="CMV_1" cdc="CMV"><DA name="cVal" type="Vector_1" bType="Struct" fc="MX" dchg="true" /><DA name="q" bType="Quality" fc="MX" qchg="true" /><DA name="t" bType="Timestamp" fc="MX" /></DOType>
    <DOType id="WYE_1" cdc="WYE"><SDO name="phsA" type="CMV_1" /><SDO name="phsB" type="CMV_1" /><SDO name="phsC" type="CMV_1" /><SDO name="neut" type="CMV_1" /></DOType>
    <DOType id="DEL_1" cdc="DEL"><SDO name="phsAB" type="CMV_1" /><SDO name="phsBC" type="CMV_1" /><SDO name="phsCA" type="CMV_1" /></DOType>

    <!-- Protecao: partida (ACD) e operacao (ACT) com indicacao de fase -->
    <DOType id="ACD_Fases" cdc="ACD"><DA name="general" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="dirGeneral" bType="Enum" type="FaultDirection" fc="ST" dchg="true" /><DA name="phsA" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="dirPhsA" bType="Enum" type="FaultDirection" fc="ST" dchg="true" /><DA name="phsB" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="dirPhsB" bType="Enum" type="FaultDirection" fc="ST" dchg="true" /><DA name="phsC" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="dirPhsC" bType="Enum" type="FaultDirection" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>
    <DOType id="ACT_Fases" cdc="ACT"><DA name="general" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="phsA" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="phsB" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="phsC" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>
    <DOType id="ACT_Generic" cdc="ACT"><DA name="general" bType="BOOLEAN" fc="ST" dchg="true" /><DA name="q" bType="Quality" fc="ST" qchg="true" /><DA name="t" bType="Timestamp" fc="ST" /></DOType>

    <DOType id="LPL_NamPlt" cdc="LPL"><DA name="vendor" bType="VisString255" fc="DC" /><DA name="swRev" bType="VisString255" fc="DC" /><DA name="d" bType="VisString255" fc="DC" /><DA name="configRev" bType="VisString255" fc="DC" /><DA name="lnNs" bType="VisString255" fc="EX" /></DOType>
    <DOType id="DPL_Generic" cdc="DPL"><DA name="vendor" bType="VisString255" fc="DC" /><DA name="model" bType="VisString255" fc="DC" /></DOType>

    <DAType id="Originator_1"><BDA name="orCat" type="OrCat" bType="Enum" /><BDA name="orIdent" bType="Octet64" /></DAType>
    <DAType id="DPCOperate_1"><BDA name="ctlVal" bType="Dbpos" type="Dbpos" /><BDA name="origin" type="Originator_1" bType="Struct" /><BDA name="ctlNum" bType="INT8U" /><BDA name="T" bType="Timestamp" /><BDA name="Test" bType="BOOLEAN" /><BDA name="Check" bType="Check" /></DAType>
    <DAType id="Vector_1"><BDA name="mag" type="AnalogueValue_1" bType="Struct" /></DAType>
    <DAType id="AnalogueValue_1"><BDA name="f" bType="FLOAT32" /></DAType>

    <EnumType id="Beh"><EnumVal ord="1">on</EnumVal><EnumVal ord="2">blocked</EnumVal><EnumVal ord="3">test</EnumVal><EnumVal ord="4">test/blocked</EnumVal><EnumVal ord="5">off</EnumVal></EnumType>
    <EnumType id="HealthKind"><EnumVal ord="1">ok</EnumVal><EnumVal ord="2">warning</EnumVal><EnumVal ord="3">alarm</EnumVal></EnumType>
    <EnumType id="CtlModels"><EnumVal ord="0">status-only</EnumVal><EnumVal ord="1">direct-with-normal-security</EnumVal><EnumVal ord="2">sbo-with-normal-security</EnumVal><EnumVal ord="3">direct-with-enhanced-security</EnumVal><EnumVal ord="4">sbo-with-enhanced-security</EnumVal></EnumType>
    <EnumType id="OrCat"><EnumVal ord="0">not-supported</EnumVal><EnumVal ord="1">bay-control</EnumVal><EnumVal ord="2">station-control</EnumVal><EnumVal ord="3">remote-control</EnumVal><EnumVal ord="4">automatic-bay</EnumVal><EnumVal ord="5">automatic-station</EnumVal><EnumVal ord="6">automatic-remote</EnumVal><EnumVal ord="7">maintenance</EnumVal><EnumVal ord="8">process</EnumVal></EnumType>
    <EnumType id="Dbpos"><EnumVal ord="0">intermediate</EnumVal><EnumVal ord="1">off</EnumVal><EnumVal ord="2">on</EnumVal><EnumVal ord="3">bad</EnumVal></EnumType>
