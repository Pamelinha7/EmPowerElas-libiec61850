[Unit]
Description=EmPowerElas - PROT (medicao, protecao e controle)
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=/home/pi/EmPowerElas-libiec61850/empelas_prot
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do ip -4 addr show eth0 | grep -q inet && exit 0; sleep 1; done; exit 0'
ExecStart=/home/pi/EmPowerElas-libiec61850/empelas_prot/empelas_prot
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
