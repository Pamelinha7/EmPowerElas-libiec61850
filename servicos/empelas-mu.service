[Unit]
Description=EmPowerElas - MU (merging unit)
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=/home/pi/empelas/empelas_mu
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do ip -4 addr show eth0 | grep -q inet && exit 0; sleep 1; done; exit 0'
ExecStart=/home/pi/empelas/empelas_mu/empelas_mu
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
